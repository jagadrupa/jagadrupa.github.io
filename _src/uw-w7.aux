\@writefile{toc}{\contentsline {section}{\numberline {6}Are These Rules Stable?}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Both unstable rules grow as straight lines on a log axis --- that is exponential growth --- reaching $\|\mathbf  {w}\|\sim 10^3$ within 15{,}000 updates. Oja's rule settles at $1/\sqrt  {\alpha }$ and stays there.}}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Oja's Rule}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}What Does Hebbian Learning Actually Do?}{8}{}\protected@file@percent }
\newlabel{sec:pca}{{8}{8}{What Does Hebbian Learning Actually Do?}{section.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: both coefficients grow without bound. Right: what matters is their \emph  {ratio} --- the share of $\mathbf  {w}$ lying along $\mathbf  {e}_1$ goes to 1, so the direction converges even though the length does not.}}{9}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9}The Brain Can Do Statistics}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The same three cases, simulated. Dashed blue is the true direction of maximum variance; the solid line is where the rule actually converged. Left and right land on it (within $0.1^\circ $ and $4^\circ $); the middle panel misses it by $90^\circ $.}}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}Where PCA Fails}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Simulated. The learnt direction runs between the two clusters, describing neither, and passes through a region containing almost no data.}}{11}{}\protected@file@percent }
