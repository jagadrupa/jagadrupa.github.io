\@writefile{toc}{\contentsline {part}{III\hspace  {1em}Sparse Coding and Predictive Coding}{20}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {22}Eigenvectors Strike Again}{20}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Patches built from localised bars, then analysed two ways. PCA returns global, wave-like patterns; sparse coding recovers single bars. Measuring the fraction of each basis vector's energy falling in its best single row or column: true parts $1.000$, PCA $0.357$, sparse coding $0.915$. Signs are arbitrary in sparse coding, so some bars come out dark.}}{21}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {23}A Linear Model with Better Basis Vectors}{21}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {24}The Generative Model: Likelihood}{22}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {25}The Generative Model: A Sparse Prior}{22}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The same three, computed. On the log axis the Gaussian is a parabola that plunges, while the sparse priors fall away far more gently --- which is exactly what a heavy tail is.}}{23}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {26}The Bayesian Objective}{24}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Sweeping the weight on the sparseness term. Reconstruction error rises monotonically as the code is forced to be sparser --- from error $0.13$ with a quarter of coefficients near zero, to $1.68$ with all of them. There is no setting that is best at both.}}{24}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Why following the gradient works from either side: left of the peak the slope is positive and $v$ increases; right of it the slope is negative and $v$ decreases.}}{25}{}\protected@file@percent }
