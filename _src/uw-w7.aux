\@writefile{toc}{\contentsline {section}{\numberline {14}The Competitive Learning Algorithm}{13}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Competitive learning run on three blobs. Weights start in the wrong places; after 1500 single-input updates each sits on a cluster centre, within $0.09$--$0.13$ of the true one. Colours show which neuron owns which points.}}{14}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces A third unit initialised away from the data. After 1500 inputs it has moved a distance of exactly $0$ and owns $0$ points, and the remaining two units are left to cover three clusters.}}{14}{}\protected@file@percent }
