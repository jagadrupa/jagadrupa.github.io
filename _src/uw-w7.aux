\@writefile{toc}{\contentsline {section}{\numberline {19}The EM Algorithm}{17}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The same overlapping data under both schemes. Winner-take-all splits them along a hard line; EM leaves a band of pale, genuinely ambiguous points --- $63$ of $360$ have a posterior between $0.1$ and $0.9$.}}{18}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {20}EM in Action}{18}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces EM on the two-cluster data, from a deliberately poor start. Dashed lines trace each mean; circles are two standard deviations. By iteration 50 the means and widths have both converged.}}{18}{}\protected@file@percent }
